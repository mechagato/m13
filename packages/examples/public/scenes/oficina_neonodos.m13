# oficina_neonodos — identidad visual NeoNodos (terracota + dorado + madera)
#
# Paleta cálida: yeso blanco con tint terracota del Brand NeoNodos
# (#E85D3B/#EF7356/#C94828), piso de madera oscura, pieza emblemática
# = esfera dorada audio-reactiva sobre pedestal de mármol central.
#
# Acentos: cubos de bronce decorativos + lámpara colgante warm-white
# que evoca el accent dorado del HUD (#c9a227).
#
# Identidad: oficina/lobby de NeoNodos. Profesional pero con calidez mexicana.
#
# T-039 — tercera escena formal del spec Fase 1 §4.5.

version: "0.1"
name: oficina_neonodos
description: "Oficina con identidad NeoNodos — terracota cálida + dorado + madera oscura"

bounds: [5.5, 3, 5.5]
spawn: [0, 0, -4]

ambient:
  background: [0.06, 0.04, 0.03]
  # Ambient color cálido amarillo-naranja (tint NeoNodos)
  ambientColor: [0.14, 0.10, 0.07]
  # Tint terracota — el brand puro #E85D3B en linear ≈ 0.78, 0.13, 0.05
  # multiplicado al color final crea ambiente cálido sin alterar materiales
  tint: [1.08, 0.95, 0.78]
  fogColor: [0.06, 0.04, 0.03]
  fogDensity: 0.015

light:
  # Luz cálida dorada cenital
  position: [0, 2.8, 0]
  color: [1.0, 0.88, 0.65]
  intensity: 1.4

walls:
  concept: pared_yeso_blanco

floor:
  concept: pared_madera_oscura
  params:
    darkness: 0.5
    grainScale: 6

ceiling:
  concept: pared_yeso_blanco

window:
  position: [0, 0.7, 5.5]
  size: [1.6, 0.9, 0.5]

objects:
  # Pieza central — pedestal + esfera dorada audio-reactiva
  - id: pedestal_central
    kind: concept
    concept: pedestal_marmol
    position: [0, -2.5, 0]
    scale: [0.45, 0.45, 0.45]

  - id: esfera_emblema
    kind: sphere
    position: [0, -1.5, 0]
    scale: 0.42
    material: metal_dorado_pulido
    audio_reactive: true
    animate:
      mode: bob
      speed: 0.5
      amplitude: 0.1

  # Cubos de bronce decorativos en esquinas (referencia al accent dorado del HUD)
  - id: cubo_bronce_izq
    kind: box
    position: [-3.5, -2.5, -3.5]
    scale: [0.3, 0.5, 0.3]
    material:
      concept: metal_bronce_pulido
      params:
        shimmer: 0.7

  - id: cubo_bronce_der
    kind: box
    position: [3.5, -2.5, -3.5]
    scale: [0.3, 0.5, 0.3]
    material:
      concept: metal_bronce_pulido
      params:
        shimmer: 0.7

  # Lámpara colgante warm-white frente al window
  - id: lampara
    kind: concept
    concept: lampara_colgante
    position: [0, 1.5, -2.5]
    scale: [0.15, 0.25, 0.15]

  # Vitrina lateral — vidrio esmerilado emulado
  - id: vitrina
    kind: round_box
    position: [-3, -1.8, 2]
    scale: [0.25, 0.7, 0.5]
    material:
      concept: vidrio_esmerilado
      params:
        clarity: 0.4
