# galeria_minimal — espacio minimalista con esfera escultórica
version: "0.1"
name: galeria_minimal
description: "Galería de arte minimalista con luz cenital fría"

bounds: [6, 3.5, 5]
spawn: [0, 0, -3.5]

ambient:
  background: [0.06, 0.065, 0.07]
  ambientColor: [0.18, 0.19, 0.21]
  tint: [0.98, 1.0, 1.02]
  fogColor: [0.06, 0.065, 0.07]
  fogDensity: 0.008

light:
  position: [0, 3.0, 0]
  color: [0.95, 0.96, 1.0]
  intensity: 1.2

walls:
  concept: pared_yeso_blanco

floor:
  concept: marmol_blanco_vetas

ceiling:
  concept: pared_yeso_blanco

objects:
  - id: pedestal_centro
    kind: round_box
    position: [0, -2.5, 0]
    scale: [0.4, 0.5, 0.4]
    material: piedra_volcanica

  - id: escultura_esfera
    kind: sphere
    position: [0, -1.4, 0]
    scale: 0.45
    material: marmol_blanco_vetas
    animate:
      mode: bob
      speed: 0.3
      amplitude: 0.04

  - id: pedestal_izq
    kind: round_box
    position: [-3, -2.5, -1.5]
    scale: [0.3, 0.5, 0.3]
    material: piedra_volcanica

  - id: torus_dorado
    kind: torus
    position: [-3, -1.4, -1.5]
    scale: [0.3, 0.1, 0.3]
    material: metal_dorado_pulido
