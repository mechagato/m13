version: "0.1"
name: chichen_itza
description: "El Castillo de Chichén Itzá — pirámide escalonada en campo abierto. Showcase del detalle continuo (Sonido 13) en el recorrido lejos → tocar la piedra."

# Explanada grande: sin walls/ceiling → escena de exterior (suelo + cielo abiertos).
bounds: [60, 25, 60]
spawn: [0, -20, 48]
cameraSpeed: 9

sky:
  horizon: [1.1, 0.82, 0.55]
  zenith: [0.35, 0.52, 0.85]

ambient:
  background: [0.45, 0.55, 0.78]
  ambientColor: [0.24, 0.22, 0.18]
  fogColor: [0.82, 0.74, 0.6]
  fogDensity: 0.016
  tint: [1.06, 0.99, 0.88]

# Sol cálido bajo al frente: ilumina la cara que mira la cámara.
light:
  position: [18, 8, 30]
  color: [1.3, 0.95, 0.6]
  intensity: 1.8

floor:
  concept: piedra_volcanica

objects:
  # 9 plataformas escalonadas (round_box), cada una con su propio seed → la piedra
  # no se repite entre niveles.
  - id: plat0
    kind: round_box
    material: piedra_volcanica
    seed: 1
    position: [0, -23.75, 0]
    scale: [22.0, 1.25, 22.0]
  - id: plat1
    kind: round_box
    material: piedra_volcanica
    seed: 2
    position: [0, -21.25, 0]
    scale: [19.7, 1.25, 19.7]
  - id: plat2
    kind: round_box
    material: piedra_volcanica
    seed: 3
    position: [0, -18.75, 0]
    scale: [17.4, 1.25, 17.4]
  - id: plat3
    kind: round_box
    material: piedra_volcanica
    seed: 4
    position: [0, -16.25, 0]
    scale: [15.1, 1.25, 15.1]
  - id: plat4
    kind: round_box
    material: piedra_volcanica
    seed: 5
    position: [0, -13.75, 0]
    scale: [12.8, 1.25, 12.8]
  - id: plat5
    kind: round_box
    material: piedra_volcanica
    seed: 6
    position: [0, -11.25, 0]
    scale: [10.5, 1.25, 10.5]
  - id: plat6
    kind: round_box
    material: piedra_volcanica
    seed: 7
    position: [0, -8.75, 0]
    scale: [8.2, 1.25, 8.2]
  - id: plat7
    kind: round_box
    material: piedra_volcanica
    seed: 8
    position: [0, -6.25, 0]
    scale: [5.9, 1.25, 5.9]
  - id: plat8
    kind: round_box
    material: piedra_volcanica
    seed: 9
    position: [0, -3.75, 0]
    scale: [3.6, 1.25, 3.6]
  # Templo superior
  - id: templo
    kind: box
    material: piedra_volcanica
    seed: 10
    position: [0, -1.0, 0]
    scale: [3.0, 1.5, 3.0]
  # Escalinata frontal (cara +z, hacia la cámara), inclinada.
  - id: escalinata
    kind: box
    material: piedra_volcanica
    seed: 11
    position: [0, -13.5, 12.5]
    rotation: [-48, 0, 0]
    scale: [3.0, 0.5, 15.5]
