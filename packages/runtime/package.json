{
  "name": "@m13/runtime",
  "version": "0.1.0",
  "description": "m13 core engine — semantic scene synthesis for WebGPU",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --declarationDir dist/types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/runtime",
    "test:coverage": "vitest run --root ../.. packages/runtime --coverage",
    "size": "size-limit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@m13/synth": "workspace:*",
    "yaml": "^2.4.2",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@webgpu/types": "^0.1.40",
    "size-limit": "^12.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  },
  "size-limit": [
    {
      "name": "@m13/runtime (ESM bundle, gzipped)",
      "path": "dist/m13-runtime.js",
      "limit": "100 KB",
      "gzip": true
    }
  ]
}
