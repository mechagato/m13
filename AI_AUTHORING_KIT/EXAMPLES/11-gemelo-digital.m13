floor:
  concept: pared_madera_oscura
ceiling:
  concept: pared_yeso_blanco
ui:
  hud: education
  locale: es
  map: true
  hints: true
player:
  spawn: [0, -1.4, -4]
  height: 1.6
  speed: 3.2
education:
