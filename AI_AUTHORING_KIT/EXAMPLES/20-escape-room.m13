# Escape room educativo

version: "0.3"
name: escape_room
title: Escape room
description: Llaves, cofres y checkpoints.
bounds: [6, 3, 6]
spawn: [0, -1.4, -4.2]
ambient:
  ambientColor: [0.08, 0.06, 0.05]
  fogDensity: 0.02
  tint: [1.05, 0.95, 0.85]
  background: [0.04, 0.03, 0.03]
  fogColor: [0.04, 0.03, 0.03]
light:
  position: [0, 2.2, 0]
  color: [1, 0.8, 0.55]
  intensity: 1.05
walls:
  concept: pared_ladrillo_viejo
floor:
  concept: piso_madera_envejecida
ceiling:
  concept: pared_concreto_pulido
ui:
  hud: education
  locale: es
  map: true
  hints: true
player:
  spawn: [0, -1.4, -4.2]
  height: 1.6
  speed: 3.2
education:
  subject: Gamificación
  grade: todos
  durationMin: 15
  language: es
  difficulty: hard
  objectives:
    - Encontrar la llave
    - Abrir el cofre
    - Salir
  bloom:
    - apply
    - analyze
  stem: false
  mode: student
objects:
  - id: llave
    kind: box
    position: [-3.8, -2.55, 2.4]
    scale: [0.18, 0.05, 0.08]
    material: metal_dorado_pulido
    label: Llave
    interact: true
  - id: cofre
    kind: box
    position: [3.2, -2.55, 2.8]
    scale: [0.55, 0.35, 0.4]
    material: cuero_vintage
    label: Cofre
    interact: true
  - id: puerta
    kind: box
    position: [0, -1.4, 5.85]
    scale: [1.2, 1.6, 0.1]
    material: pared_madera_oscura
    label: Puerta
    interact: true
  - id: pista
    kind: box
    position: [3.6, 0.2, -5.7]
    scale: [0.7, 0.4, 0.05]
    material: marmol_blanco_vetas
    label: Pista
    interact: true
npc:
  - id: maestro
    name: Game master
    role: guide
    position: [-2, -3, -3]
    dialog:
      - "Tres pasos: pista, llave, cofre."
      - La puerta no abre sin el cofre.
zones:
  - id: salida
    kind: box
    position: [0, -1.4, 5.2]
    hidden: false
    size: [1.4, 1.5, 0.8]
    label: Salida
missions:
  - id: m1
    title: Pista
    description: Lee la pista en el muro.
    objective:
      interact: pista
    success: "Completaste: Pista"
    rewards:
      xp: 40
      stars: 1
    required: true
    next: m2
    hints:
      - Está en la pared detrás de ti.
  - id: m2
    title: Llave
    description: Recoge la llave.
    objective:
      interact: llave
    success: "Completaste: Llave"
    rewards:
      xp: 80
      stars: 1
      badge: llave
    required: true
    next: m3
  - id: m3
    title: Cofre
    description: Abre el cofre con la llave.
    objective:
      interact: cofre
    success: "Completaste: Cofre"
    rewards:
      xp: 100
      stars: 1
      badge: cofre
    required: true
    next: m4
  - id: m4
    title: Salida
    description: Entra a la zona de la puerta.
    objective:
      enter_zone: salida
    success: "Completaste: Salida"
    rewards:
      xp: 120
      stars: 1
      badge: escape
    required: true
