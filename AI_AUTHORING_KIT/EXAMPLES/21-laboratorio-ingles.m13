# Laboratorio de inglés — 3° preescolar a 2° primaria

version: "0.3"
name: laboratorio_ingles
title: English Lab
description: "Colors and animals. Laboratorio de inglés para niños."
bounds: [8, 3.2, 7]
spawn: [0, -1.85, -5]
ambient:
  background: [0.12, 0.1, 0.08]
  ambientColor: [0.22, 0.2, 0.16]
  tint: [1.04, 1.01, 0.96]
  fogColor: [0.12, 0.1, 0.08]
  fogDensity: 0.008
light:
  position: [0, 2.4, 0]
  color: [1.05, 0.96, 0.82]
  intensity: 1.25
walls:
  concept: pared_yeso_blanco
floor:
  concept: piso_madera_envejecida
ceiling:
  concept: pared_yeso_blanco
cameraSpeed: 3.0
ui:
  hud: education
  locale: es
  map: true
  hints: true
player:
  spawn: [0, -1.85, -5]
  height: 1.35
  speed: 2.8
education:
  subject: Inglés
  grade: 3° preescolar – 2° primaria
  durationMin: 12
  language: en
  difficulty: intro
  objectives:
    - Saludar en inglés
    - Identificar el color RED
    - Identificar CAT
  bloom:
    - remember
    - understand
  stem: false
  mode: student
objects:
  - id: pizarron
    kind: box
    position: [0, -0.2, 6.55]
    scale: [3.0, 1.35, 0.07]
    material: pared_concreto_pulido
    label: Board
    interact: true
  - id: mesa_colores
    kind: box
    position: [-2.4, -2.75, 0.4]
    scale: [1.6, 0.32, 0.55]
    material: pared_madera_oscura
  - id: red_ball
    kind: sphere
    position: [-3.2, -2.15, 0.4]
    scale: 0.28
    material: metal_oxidado
    label: RED
    interact: true
  - id: blue_cube
    kind: box
    position: [-2.4, -2.15, 0.4]
    scale: [0.22, 0.22, 0.22]
    material: vidrio_esmerilado
    label: BLUE
    interact: true
  - id: yellow_star
    kind: torus
    position: [-1.6, -2.1, 0.4]
    scale: [0.22, 0.08, 0.22]
    material: metal_dorado_pulido
    label: YELLOW
    interact: true
  - id: green_tree
    kind: cylinder
    position: [2.8, -2.55, 1.2]
    scale: [0.35, 0.7, 0.35]
    material: piedra_volcanica
    label: GREEN
    interact: true
  - id: cat
    kind: sphere
    position: [2.2, -2.85, -1.2]
    scale: 0.42
    material: cuero_vintage
    label: CAT
    interact: true
    animate:
      mode: bob
      speed: 1.6
      amplitude: 0.04
  - id: dog
    kind: sphere
    position: [3.4, -2.85, -0.4]
    scale: 0.48
    material: metal_bronce_pulido
    label: DOG
    interact: true
  - id: bird
    kind: sphere
    position: [-3.2, -2.2, 3.2]
    scale: 0.22
    material: vidrio_esmerilado
    label: BIRD
    interact: true
    animate:
      mode: bob
      speed: 2.4
      amplitude: 0.08
  - id: poster_colors
    kind: box
    position: [6.2, 0.2, 2]
    scale: [0.06, 0.7, 0.9]
    rotation: [0, 90, 0]
    material: metal_dorado_pulido
    label: Colors
  - id: lampara
    kind: concept
    position: [0, 2.15, 0]
    scale: [0.16, 0.28, 0.16]
    concept: lampara_colgante
npc:
  - id: miss_luna
    name: Miss Luna
    role: teacher
    voice: en-US
    position: [-2.2, -3.2, 5.2]
    dialog:
      - "Hello! I am Miss Luna."
      - "Hoy jugamos con English. Colors and animals."
      - "Find something RED. Rojo. Touch the red ball."
      - "Then find the CAT. El gato."
    mission: m1
zones:
  - id: colors
    kind: box
    position: [-2.4, -2.2, 0.4]
    hidden: true
    size: [1.8, 1.2, 1.0]
    label: Colors table
quizzes:
  - id: q_cat
    prompt: "¿Cómo se dice gato en inglés?"
    choices:
      - Dog
      - Cat
      - Red
      - Bird
    answer: 1
    bloom: remember
    xp: 80
missions:
  - id: m1
    title: Say hello
    description: Habla con Miss Luna. Hello!
    objective:
      talk: miss_luna
    success: "Hello! +40 XP"
    rewards:
      xp: 40
      stars: 1
    required: true
    next: m2
    hints:
      - Miss Luna está junto al pizarrón. Pulsa E.
  - id: m2
    title: Find RED
    description: Toca la pelota roja. RED = rojo.
    objective:
      interact: red_ball
    success: "Red! Muy bien."
    rewards:
      xp: 90
      stars: 1
      badge: colors
    required: true
    next: m3
    hints:
      - La pelota roja está sobre la mesa de colores, a la izquierda.
  - id: m3
    title: Find the CAT
    description: Toca el gato. CAT = gato.
    objective:
      interact: cat
    success: "Cat! Excellent."
    rewards:
      xp: 100
      stars: 1
      badge: animals
    required: true
    next: m4
    hints:
      - El gato está en el piso, a la derecha.
  - id: m4
    title: Quiz
    description: ¿Cómo se dice gato?
    objective:
      quiz: q_cat
    success: "You did it!"
    rewards:
      xp: 80
      stars: 1
      badge: english
    required: true
events:
  - trigger: mission_completed
    target: m4
    action:
      fireworks: true
      sound: success
