# Historia de México — templo

version: "0.3"
name: historia_mexico
title: Historia de México
description: Templo de piedra volcánica y brasero. Recorrido mexica.
bounds: [6, 3.5, 6]
spawn: [0, -1.9, -4]
ambient:
  background: [0.08, 0.04, 0.02]
  ambientColor: [0.04, 0.025, 0.015]
  tint: [1.15, 0.92, 0.7]
  fogColor: [0.08, 0.04, 0.02]
  fogDensity: 0.025
light:
  position: [0, -1.5, 0]
  color: [1.4, 0.7, 0.25]
  intensity: 1.8
walls:
  concept: piedra_volcanica
floor:
  concept: piedra_volcanica
ceiling:
  concept: piedra_volcanica
ui:
  hud: education
  locale: es
  map: true
  hints: true
player:
  spawn: [0, -1.9, -4]
  height: 1.6
  speed: 3.2
education:
  subject: Historia
  grade: secundaria
  durationMin: 18
  language: es
  difficulty: medium
  objectives:
    - Identificar el brasero
    - Relatar el templo
  bloom:
    - remember
    - understand
  stem: false
  mode: student
objects:
  - id: brasero
    kind: cylinder
    position: [0, -3.1, 0]
    scale: [0.45, 0.2, 0.45]
    material: piedra_volcanica
    label: Brasero
    interact: true
  - id: flama
    kind: sphere
    position: [0, -2.5, 0]
    scale: 0.3
    material: metal_dorado_pulido
    animate:
      mode: bob
      speed: 4.0
      amplitude: 0.08
  - id: columna_izq
    kind: cylinder
    position: [-3.5, 0, -3.5]
    scale: [0.35, 3.0, 0.35]
    material: piedra_volcanica
  - id: columna_der
    kind: cylinder
    position: [3.5, 0, -3.5]
    scale: [0.35, 3.0, 0.35]
    material: piedra_volcanica
  - id: altar
    kind: box
    position: [0, -3.2, 3.2]
    scale: [1.1, 0.25, 0.6]
    material: piedra_volcanica
    label: Altar
    interact: true
npc:
  - id: tlacuilo
    name: Tlacuilo
    role: teacher
    position: [2, -3.5, -2]
    dialog:
      - Este recinto recuerda un templo mexica.
      - El fuego del brasero era ofrenda.
      - Acércate al altar al fondo.
zones:
  - id: fuego
    kind: sphere
    position: [0, -2.6, 0]
    hidden: false
    radius: 1.2
    label: Fuego
missions:
  - id: m1
    title: Escucha al tlacuilo
    description: Habla con el narrador.
    objective:
      talk: tlacuilo
    success: "Completaste: Escucha al tlacuilo"
    rewards:
      xp: 50
      stars: 1
    required: true
    next: m2
  - id: m2
    title: Observa el fuego
    description: Entra a la zona del brasero.
    objective:
      enter_zone: fuego
    success: "Completaste: Observa el fuego"
    rewards:
      xp: 90
      stars: 1
      badge: ofrenda
    required: true
    next: m3
  - id: m3
    title: El altar
    description: Interactúa con el altar.
    objective:
      interact: altar
    success: "Completaste: El altar"
    rewards:
      xp: 80
      stars: 1
    required: true
