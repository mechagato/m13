    label: Brazo
    interact: true
  - id: extintor
    kind: cylinder
    position: [-5.5, -2.4, 5.2]
    scale: [0.12, 0.45, 0.12]
    material: metal_oxidado
    label: Extintor
    interact: true
npc:
  - id: supervisor
    name: Supervisor
    role: teacher
    position: [-3, -3.2, -4]
    dialog:
      - Casco obligatorio en piso de planta.
      - Sigue la línea y no cruces la banda.
      - El extintor está en la esquina.
zones:
  - id: linea
    kind: box
    position: [0, -2.4, 0]
