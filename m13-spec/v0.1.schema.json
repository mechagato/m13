{
  "$ref": "#/definitions/M13Scene",
  "definitions": {
    "M13Scene": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "default": "0.1"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bounds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "default": [
            5,
            3,
            5
          ]
        },
        "spawn": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "default": [
            0,
            0,
            -3.5
          ]
        },
        "ambient": {
          "type": "object",
          "properties": {
            "background": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ],
              "default": [
                0.05,
                0.045,
                0.04
              ]
            },
            "ambientColor": {
              "$ref": "#/definitions/M13Scene/properties/ambient/properties/background",
              "default": [
                0.08,
                0.075,
                0.07
              ]
            },
            "tint": {
              "$ref": "#/definitions/M13Scene/properties/ambient/properties/background",
              "default": [
                1,
                1,
                1
              ]
            },
            "fogColor": {
              "$ref": "#/definitions/M13Scene/properties/ambient/properties/background",
              "default": [
                0.05,
                0.045,
                0.04
              ]
            },
            "fogDensity": {
              "type": "number",
              "minimum": 0,
              "default": 0.015
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "light": {
          "type": "object",
          "properties": {
            "position": {
              "$ref": "#/definitions/M13Scene/properties/spawn",
              "default": [
                0,
                2.5,
                0
              ]
            },
            "color": {
              "$ref": "#/definitions/M13Scene/properties/ambient/properties/background",
              "default": [
                1,
                0.92,
                0.78
              ]
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "default": 1
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "walls": {
          "type": "object",
          "properties": {
            "concept": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "concept"
          ],
          "additionalProperties": false
        },
        "floor": {
          "$ref": "#/definitions/M13Scene/properties/walls"
        },
        "ceiling": {
          "$ref": "#/definitions/M13Scene/properties/walls"
        },
        "sky": {
          "type": "object",
          "properties": {
            "horizon": {
              "$ref": "#/definitions/M13Scene/properties/ambient/properties/background"
            },
            "zenith": {
              "$ref": "#/definitions/M13Scene/properties/ambient/properties/background"
            }
          },
          "required": [
            "horizon",
            "zenith"
          ],
          "additionalProperties": false
        },
        "cameraSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "window": {
          "type": "object",
          "properties": {
            "position": {
              "$ref": "#/definitions/M13Scene/properties/spawn"
            },
            "size": {
              "$ref": "#/definitions/M13Scene/properties/bounds"
            }
          },
          "required": [
            "position",
            "size"
          ],
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "sphere",
                  "box",
                  "round_box",
                  "cylinder",
                  "torus",
                  "concept"
                ]
              },
              "concept": {
                "type": "string"
              },
              "position": {
                "$ref": "#/definitions/M13Scene/properties/spawn"
              },
              "rotation": {
                "$ref": "#/definitions/M13Scene/properties/spawn"
              },
              "scale": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "$ref": "#/definitions/M13Scene/properties/bounds"
                  }
                ],
                "default": 1
              },
              "seed": {
                "type": "number"
              },
              "material": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "concept": {
                        "type": "string"
                      },
                      "params": {
                        "type": "object",
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "concept"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "audio_reactive": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "band": {
                        "type": "string",
                        "enum": [
                          "bass",
                          "mid",
                          "treble"
                        ]
                      }
                    },
                    "required": [
                      "band"
                    ],
                    "additionalProperties": false
                  }
                ],
                "default": false
              },
              "animate": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "bob",
                      "rotate",
                      "pulse"
                    ]
                  },
                  "speed": {
                    "type": "number",
                    "default": 1
                  },
                  "amplitude": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.1
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "position"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "name",
        "floor"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
