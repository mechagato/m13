{
  "name": "m13",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "m13 — local-first world synthesis engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @m13/examples dev",
    "typecheck": "pnpm -r typecheck",
    "gen:schema": "tsx tools/gen-json-schema.ts",
    "gen:qr": "tsx tools/gen-qr.ts",
    "bench:compile": "tsx tools/bench-compile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^8.57.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "qrcode": "^1.5.4",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  }
}
