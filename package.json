{
  "name": "m13",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Genaro Isaí García Torres",
  "type": "module",
  "description": "Local-first WebGPU/WebXR world synthesis from .m13 semantic scenes.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @m13/examples dev",
    "gateway": "pnpm --filter @m13/gateway start",
    "playground": "pnpm --filter @m13/playground start",
    "typecheck": "pnpm -r typecheck",
    "gen:schema": "tsx tools/gen-json-schema.ts",
    "validate:overlay": "tsx tools/validate-overlay.ts",
    "gen:hashes": "tsx tools/hash-scenes.ts",
    "gen:qr": "tsx tools/gen-qr.ts",
    "bench:compile": "tsx tools/bench-compile.ts",
    "test": "vitest run --testTimeout=20000",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "export-concepts": "tsx tools/export-concepts.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.1",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.0.5",
      "postcss": "^8.5.23",
      "sharp": "^0.35.3"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
